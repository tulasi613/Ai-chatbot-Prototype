# Copy this file to .env and fill in your local MySQL credentials.

# ---- MySQL ----
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=restock_ai

# ---- Notifications (all optional — leave blank to use SIMULATED mode) ----
# Option A: SendGrid
SENDGRID_API_KEY=

# Option B: Plain SMTP (e.g. Gmail app password, Mailtrap, etc.)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=restock-alerts@example.com

# ---- Business rules ----
HIGH_INTEREST_THRESHOLD=5
LOW_STOCK_LOOKAHEAD_DAYS=7
