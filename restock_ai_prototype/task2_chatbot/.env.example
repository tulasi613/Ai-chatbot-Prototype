# Copy to .env and edit. Every value has a working default — the file is optional.

# ----------------------------------------------------------------- database
# sqlite = zero-setup demo (default) | mysql = the real schema on a MySQL server
DB_ENGINE=sqlite

# Used only when DB_ENGINE=mysql
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=restock_ai

# Used only when DB_ENGINE=sqlite
# SQLITE_PATH=data/restock_ai.db

# ----------------------------------------------------------------- server
HOST=127.0.0.1
PORT=5055

# ----------------------------------------------------------------- tuning
# Demand score at which an out-of-stock product is escalated to the admin log.
HIGH_INTEREST_THRESHOLD=6
# Weight of each interest signal.
WEIGHT_QUERY=1.0
WEIGHT_SUBSCRIPTION=3.0
# Only interest inside this rolling window counts.
INTEREST_WINDOW_DAYS=21
# How many alternatives the chatbot offers.
MAX_ALTERNATIVES=3
